# ========================================
# CONFIGURACIÓN DEL SERVIDOR
# ========================================
PORT=3000
NODE_ENV=development # development, production, test

# ========================================
# CONFIGURACIÓN DE MONGODB
# ========================================
# Cambia 'localhost' por '127.0.0.1' si tienes problemas de conexión
MONGO_URI=mongodb://localhost:27017/task_manager

# ========================================
# CONFIGURACIÓN DE JWT (AUTENTICACIÓN)
# ========================================
# Clave secreta para firmar tokens
# Generar una segura: openssl rand -base64 32
JWT_SECRET=escribe_aqui_una_clave_aleatoria_muy_larga

# Tiempo de expiración: 15m (test), 1h, 7d
JWT_EXPIRES_IN=7d

# ========================================
# CONFIGURACIÓN DE SEGURIDAD (Rate Limit)
# ========================================
# Límite de peticiones para la Prova 8.5
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# CONFIGURACIÓN DE CLOUDINARY
# ========================================
# Obtenido de tu Dashboard de Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name_aqui
CLOUDINARY_API_KEY=tu_api_key_aqui
CLOUDINARY_API_SECRET=tu_api_secret_aqui